# compiled output
/dist
/node_modules
/packages/*/dist
/packages/*/node_modules
/examples/*/dist
/examples/*/node_modules
/build

# Pre-monorepo Nest tree (ADR-0032); never recreate at repo root
/src
/test
/prisma

# Prisma Client (regenerated by `prisma generate`)
/examples/nestjs/src/generated

# Drih HTML and host-compiled island CSS (regenerated by dehydrate / Vite)
/examples/nestjs/views/components/dehydrated
/examples/nestjs/views/components/dehydrated-css

# TypeScript build cache
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
**/coverage
/.nyc_output
/examples/nestjs/test/.e2e-database-url
**/__screenshots__/
.vitest-attachments/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Storybook
**/storybook-static
